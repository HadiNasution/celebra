{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc --project tsconfig.build.json && node dist/main",
    "dev:watch": "tsc --project tsconfig.build.json --watch",
    "start:dev": "node --watch dist/main",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:push": "drizzle-kit push",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.44",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "jest": "^30",
    "prettier": "^3",
    "supertest": "^7",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
