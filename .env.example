# ============================================
# Celebra — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Database
DATABASE_URL=postgres://celebra:celebra@localhost:5432/celebra
DATABASE_TEST_URL=postgres://celebra:celebra@localhost:5432/celebra_test

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000

# Backend
PORT=3001

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-string

# Xendit Payment
XENDIT_API_KEY=mock
XENDIT_CALLBACK_TOKEN=mock-callback-token

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@celebra.com

# Cloudflare R2 (for image/media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=celebra
R2_PUBLIC_URL=
